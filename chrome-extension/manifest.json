{
  "manifest_version": 3,
  "name": "Meeting Transcriber — Google Meet",
  "version": "0.11.0",
  "description": "Локально зберігає live captions із Google Meet.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:43119/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "rtc-caption-codec.js",
        "rtc-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "caption-model.js",
        "auto-export.js",
        "rtc-fallback.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meeting Transcriber"
  }
}
