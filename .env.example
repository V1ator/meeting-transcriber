# Скопіюйте у .env і заповніть. Python-сервіси читають файл напряму.
# ⚠️ .env містить секрет — не комітити, не пересилати.
HF_TOKEN=hf_...
# Незалежні модулі: керуйте через `.venv/bin/python3 modules.py configure`
AUDIO_PIPELINE_ENABLED=true
OLLAMA_MODEL=qwen3.6:27b-q4_K_M
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false             # legacy fallback for summary stages
SUMMARY_EXTRACT_THINK=false    # fast evidence extraction
SUMMARY_RECONCILE_THINK=true   # reasoning only for decisions/contradictions
SUMMARY_CONTEXT_NUM_PREDICT=4096 # output budget for contextual evidence JSON
SUMMARY_CONTEXT_REPAIR_ITEMS=5 # compact retry after malformed/truncated JSON
SUMMARY_CRITICAL_MERGE_NUM_PREDICT=8192 # output budget for large critical-evidence JSON merges
SUMMARY_CRITICAL_RECONCILE_NUM_PREDICT=8192 # output budget after reasoning reconciliation
ROTATE_DAYS=5
RECORD_MIC_MODE=single       # single/headphones | multiple/speakers; capture завжди Raw
MLX_MODEL=mlx-community/whisper-large-v3-mlx
TRANSCRIBE_LANGUAGE=uk       # uk | auto
DIARIZE_DEVICE=auto          # auto = MPS з автоматичним fallback на CPU
DEDUP_MIC=true               # прибирати дублікати mic/sys після запису
MIN_SESSION_SECONDS=10       # коротші записи не відправляються в ASR/LLM
SILENT_RECORDING_PEAK_DBFS=-70 # обидві доріжки нижче порога → не запускати ASR/LLM
MAX_AUTO_RETRIES=8        # ~2 години retry-вікна для Ollama/тимчасових збоїв
ALLOW_REMOTE_OLLAMA=false    # захист від випадкового витоку транскрипту
MEET_AUTO_IMPORT=true        # імпортувати нові meet-*.json із Downloads
MEET_AUTO_SUMMARY=true       # одразу створювати summary та note через Ollama
MEET_IMPORT_EXISTING=false   # true = також імпортувати старий backlog
MEET_DOWNLOADS_DIR=~/Downloads
MEET_IMPORT_STABLE_SECONDS=5 # чекати завершення завантаження JSON
CANDIDATE_EVALUATION_ENABLED=false # enable after adding skills/candidate-evaluation/
CANDIDATE_MEETING_KEYWORDS=hiring,interview,networking
CANDIDATE_LEVELS=Junior,Middle,Senior,Lead # levels compared in every report
CANDIDATE_TARGET_LEVEL=       # optional role + level fallback, e.g. Junior Data Analyst
CANDIDATE_OLLAMA_THINK=true   # reasoning only for candidate evaluation
CANDIDATE_INTERVIEWER_NAMES=  # comma-separated; fallback when title lacks candidate name
MAX_RECORD_SECONDS=21600     # 6 год
MIC_AUTO_START=false         # false: лише ручний запуск, без моніторингу/popup
SILENCE_POPUP=true           # запропонувати stop, якщо обидві доріжки тихі
SILENCE_SECONDS=90
SILENCE_MIN_RECORD_SECONDS=90
SILENCE_REPEAT_SECONDS=600
SILENCE_DIALOG_TIMEOUT=30
SILENCE_AUTO_STOP_SECONDS=300 # після timeout popup завершити на 5-й хв тиші
MIC_ACTIVITY_DBFS=-42
SYSTEM_ACTIVITY_DBFS=-50

# Notion action items + candidate feedback tasks. View ID потрібен лише для довідки.
NOTION_SYNC_ENABLED=false
NOTION_API_KEY=ntn_...
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
NOTION_VIEW_ID=
NOTION_TASK_OWNER_NAMES=Current User,Поточний користувач # only these owners are synced
